{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "build",
  "shell": "/bin/zsh",
  "logLevel": "INFO",
  "share": "disabled",
  "snapshot": true,
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": ["~/.agents/skills"]
  },
  "plugin": [
    "@plannotator/opencode@0.25.0",
    "opencode-notify@0.3.1",
    "context-mode@1.0.169",
    "@tarquinen/opencode-dcp@3.1.14"
  ],
  "permission": {
    "external_directory": {
      "*": "allow",
      "~/.config/opencode/**": "allow",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.local/share/opencode/mcp-auth.json": "deny"
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "printenv *": "deny",
      "env": "deny",
      "env *": "deny",
      "export *": "deny",
      "gh auth *": "deny",
      "cat *.env": "deny",
      "cat *.env.*": "deny",
      "cat **/.env": "deny",
      "cat **/.env.*": "deny",
      "cat *.envrc": "deny",
      "cat **/.envrc": "deny",
      "cat .dev.vars": "deny",
      "cat **/.dev.vars": "deny",
      "cat *.pem": "deny",
      "cat *.key": "deny",
      "cat **/.aws/**": "deny",
      "cat **/.ssh/**": "deny"
    },
    "webfetch": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.envrc": "deny",
      ".dev.vars": "deny",
      "**/.dev.vars": "deny",
      "secrets/*": "deny",
      "**/secrets/**": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "**/.aws/**": "deny",
      "**/.ssh/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.local/share/opencode/mcp-auth.json": "deny",
      "~/.config/opencode/secrets/**": "deny"
    },
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "tools": {
    "todowrite": true,
    "todoread": true
  },
  "mcp": {
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.config/opencode/secrets/context7-api-key}"
      },
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "opensrc": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "opensrc-mcp@0.3.0"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.78"
      ],
      "enabled": false
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "target/**",
      "coverage/**",
      ".next/**",
      ".turbo/**",
      "*.log"
    ]
  }
}
