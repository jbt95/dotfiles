{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "build",
  "shell": "/bin/zsh",
  "logLevel": "INFO",
  "share": "disabled",
  "snapshot": true,
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": ["~/.agents/skills"]
  },
  "plugin": [
    "@plannotator/opencode@0.25.0",
    "opencode-notify@0.3.1",
    "context-mode@1.0.169",
    "@tarquinen/opencode-dcp@3.1.14"
  ],
  "permission": {
    "external_directory": {
      "*": "allow",
      "~/work/**": "allow",
      "~/.config/opencode/**": "allow",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.local/share/opencode/mcp-auth.json": "deny"
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git branch --show-current*": "allow",
      "printenv *": "deny",
      "env": "deny",
      "env *": "deny",
      "export *": "deny",
      "gh auth *": "deny",
      "cat *.env": "deny",
      "cat *.env.*": "deny",
      "cat **/.env": "deny",
      "cat **/.env.*": "deny",
      "cat *.envrc": "deny",
      "cat **/.envrc": "deny",
      "cat .dev.vars": "deny",
      "cat **/.dev.vars": "deny",
      "cat *.pem": "deny",
      "cat *.key": "deny",
      "cat **/.aws/**": "deny",
      "cat **/.ssh/**": "deny",
      "terraform apply*": "deny",
      "terraform * apply*": "deny",
      "terraform destroy*": "deny",
      "terraform * destroy*": "deny",
      "tofu apply*": "deny",
      "tofu * apply*": "deny",
      "tofu destroy*": "deny",
      "tofu * destroy*": "deny",
      "rm -rf*": "deny",
      "rm * -rf*": "deny"
    },
    "webfetch": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "skill": {
      "*": "allow"
    },
    "context7_resolve-library-id": "deny",
    "context7_query-docs": "deny",
    "gh_grep_searchGitHub": "deny",
    "opensrc_execute": "deny"
  },
  "tools": {
    "todowrite": true,
    "todoread": true
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": false
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:PI_MCP_CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "opensrc": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "opensrc-mcp@0.3.0"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.78"
      ],
      "enabled": false
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "target/**",
      "coverage/**",
      ".next/**",
      ".turbo/**",
      "*.log"
    ]
  }
}
