{
  "packages": [
    "npm:pi-subagents",
    "npm:latchkey",
    "npm:taskplane",
    "npm:pi-lens",
    "npm:pi-mcp-adapter@2.15.0",
    "npm:@gotgenes/pi-permission-system@20.10.0",
    "npm:@plannotator/pi-extension@0.24.2",
    "npm:context-mode",
    "npm:@zigai/pi-mention-project",
    "npm:pi-web-access",
    "npm:@victor-software-house/pi-curated-themes",
    "npm:pi-markdown-preview"
  ],
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "enableSkillCommands": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "lastChangelogVersion": "0.82.0",
  "theme": "vesper",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false
}