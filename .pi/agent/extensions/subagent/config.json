{
  "asyncByDefault": false,
  "globalConcurrencyLimit": 4,
  "parallel": {
    "maxTasks": 8,
    "concurrency": 4
  },
  "maxSubagentSpawnsPerSession": 12,
  "maxSubagentDepth": 2,

  "agentDefaults": {
    "timeoutMs": 120000,
    "idleTimeoutMs": 30000,
    "lifecycle": "session"
  },

  "agents": {
    "change-reviewer": { "file": "agents/change-reviewer.md" },
    "code-reviewer": { "file": "agents/code-reviewer.md" },
    "frontend-specialist": { "file": "agents/frontend-specialist.md" },
    "java-spring-specialist": { "file": "agents/java-spring-specialist.md" },
    "librarian": { "file": "agents/librarian.md" },
    "oracle": { "file": "agents/oracle.md" }
  },

  "routing": {
    "onUserRequest": [
      { "agent": "change-reviewer", "when": "review,diff,PR,merge", "autoSpawn": false },
      { "agent": "librarian", "when": "library,documentation,third-party,source", "autoSpawn": false },
      { "agent": "oracle", "when": "architecture,design,debug,plan", "autoSpawn": false }
    ]
  },

  "budget": {
    "defaultMaxTokens": 8000,
    "defaultThinkingLevel": "medium",
    "perAgent": {
      "change-reviewer": { "maxTokens": 12000, "thinkingLevel": "low" },
      "librarian": { "maxTokens": 12000, "thinkingLevel": "high" },
      "oracle": { "maxTokens": 16000, "thinkingLevel": "high" }
    }
  }
}
