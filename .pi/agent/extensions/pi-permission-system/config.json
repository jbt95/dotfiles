{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/pi-permission-system-v20.10.0/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "permissionReviewLog": true,
  "permission": {
    "*": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "external_directory": "allow",
    "path": {
      "*": "allow",
      "*.env": {
        "action": "deny",
        "reason": "Environment files may contain credentials."
      },
      "*.env.*": {
        "action": "deny",
        "reason": "Environment files may contain credentials."
      },
      "*.envrc": {
        "action": "deny",
        "reason": "Environment files may contain credentials."
      },
      "*.dev.vars": {
        "action": "deny",
        "reason": "Development variable files may contain credentials."
      },
      "*secrets/*": {
        "action": "deny",
        "reason": "Secret stores are protected."
      },
      "*.pem": {
        "action": "deny",
        "reason": "Certificate and private-key material is protected."
      },
      "*.key": {
        "action": "deny",
        "reason": "Private-key material is protected."
      },
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.aws": "deny",
      "~/.aws/*": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/mcp-auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.local/share/opencode/mcp-auth.json": "deny"
    },
    "bash": {
      "*": "allow",
      "*printenv*": {
        "action": "deny",
        "reason": "Do not dump process environment variables."
      },
      "*env *": {
        "action": "deny",
        "reason": "Do not dump or indirectly expose process environment variables."
      },
      "env": {
        "action": "deny",
        "reason": "Do not dump process environment variables."
      },
      "*export *": {
        "action": "deny",
        "reason": "Do not print or alter exported environment state."
      },
      "export": {
        "action": "deny",
        "reason": "Do not print exported environment state."
      },
      "*gh auth *": {
        "action": "deny",
        "reason": "GitHub authentication commands may expose or alter credentials."
      },
      "gh auth": {
        "action": "deny",
        "reason": "GitHub authentication commands may expose or alter credentials."
      }
    }
  }
}
