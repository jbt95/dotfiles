{
  "settings": {
    "directTools": false,
    "autoAuth": false,
    "outputGuard": true,
    "idleTimeout": 10,
    "requestTimeoutMs": 60000
  },
  "mcpServers": {
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "lifecycle": "lazy",
      "directTools": true
    },
    "bitbucket-mcp": {
      "url": "http://127.0.0.1:3030/mcp",
      "headers": {
        "X-ATLASSIAN-USER-EMAIL": "${PI_MCP_ATLASSIAN_USER_EMAIL}",
        "X-BITBUCKET-API-TOKEN": "${PI_MCP_BITBUCKET_API_TOKEN}"
      },
      "lifecycle": "lazy"
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "lifecycle": "lazy"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${PI_MCP_CONTEXT7_API_KEY}"
      },
      "lifecycle": "lazy",
      "directTools": true
    },
    "gh_grep": {
      "url": "https://mcp.grep.app",
      "lifecycle": "lazy",
      "directTools": true
    },
    "opensrc": {
      "command": "npx",
      "args": [
        "-y",
        "opensrc-mcp"
      ],
      "lifecycle": "lazy",
      "directTools": true
    },
    "context-mode": {
      "command": "context-mode"
    }
  }
}
